{
  "name": "@tchryssos/js-config",
  "version": "0.3.2",
  "description": "Shared JS tooling config (TypeScript, ESLint + Prettier or oxlint + oxfmt, stylelint, lefthook) and a CLI that keeps the files that can't be extended in sync.",
  "private": true,
  "type": "module",
  "repository": "github:tchryssos/js-config",
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "js-config": "bin/js-config.js"
  },
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./prettier/astro": "./prettier/astro.js",
    "./prettier/tailwind": "./prettier/tailwind.js",
    "./stylelint": "./stylelint/index.json",
    "./oxlint": "./oxlint/base.json",
    "./lefthook/*": "./lefthook/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "eslint",
    "files",
    "lefthook",
    "lib",
    "oxlint",
    "prettier",
    "stylelint",
    "tsconfig"
  ],
  "scripts": {
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "typescript-eslint": "^8.72.2",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "knip": ">=6",
    "lefthook": ">=2",
    "oxfmt": ">=0.70",
    "oxlint": ">=1",
    "prettier": ">=3",
    "stylelint": ">=18",
    "typescript": ">=6"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3"
  }
}
